<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Cado</string>
    <key>CFBundleDisplayName</key>
    <string>Cado</string>
    <key>CFBundleIdentifier</key>
    <string>com.ropats16.Cado</string>
    <key>CFBundleExecutable</key>
    <string>Cado</string>
    <!-- Resources/AppIcon.icns (scripts/make_app_icon.py); package_app.sh copies it in. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- TelemetryDeck app ID for the opt-in launch ping (#26). Empty = the ping never sends. -->
    <key>CadoTelemetryAppID</key>
    <string></string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu-bar-only agent: no Dock icon, no default window. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Sparkle 2 auto-update (#24; docs/RELEASING.md). Dev builds (make package /
         make install) delete SUFeedURL, so only release builds check. The key is the
         PUBLIC half of the Ed25519 key in the maintainer's login keychain (Sparkle
         generate_keys, account "cado"); the app refuses to start the updater while it
         is the placeholder SPARKLE_PUBLIC_ED_KEY_PLACEHOLDER. Checks: daily, on by
         default (no first-run prompt), toggled in Settings > General; installs only
         after the user agrees; no system profile is sent. -->
    <key>SUFeedURL</key>
    <string>https://github.com/ropats16/cado/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>rdsAG+/pd7Ht6XqvSHktNN79TMYuWJHVRfzD8PEyOpE=</string>
    <!-- Enabled after the public 0.4.0 signed feed was verified (#49). -->
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUEnableSystemProfiling</key>
    <false/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Cado records your voice locally to transcribe it into text. Audio is processed on-device and never leaves your Mac.</string>
    <!-- System audio (Core Audio process taps, macOS 14.2+) for meeting notes. Without
         this key a tap records silence and macOS never shows the prompt. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>Cado records your Mac's audio during a meeting you start, so the other participants are transcribed alongside you. Audio is processed on-device and never leaves your Mac.</string>
    <!-- Calendar read access (macOS 14+) for "Name meetings from my calendar" (#38). Asked
         only when the user switches that on; without this key macOS kills the app on the request. -->
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Cado reads your calendar to name a meeting note after the event you're in, and to list who was invited. macOS only offers full access, but Cado only reads events and never changes them. Your calendar is read on this Mac and isn't sent anywhere; the event's title and the names of the people invited are saved in the note, so they go wherever your notes folder syncs.</string>
</dict>
</plist>
