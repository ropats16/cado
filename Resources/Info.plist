<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Cado</string>
    <key>CFBundleDisplayName</key>
    <string>Cado</string>
    <key>CFBundleIdentifier</key>
    <string>com.ropats16.Cado</string>
    <key>CFBundleExecutable</key>
    <string>Cado</string>
    <!-- Resources/AppIcon.icns (scripts/make_app_icon.py); package_app.sh copies it in. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu-bar-only agent: no Dock icon, no default window. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Cado records your voice locally to transcribe it into text. Audio is processed on-device and never leaves your Mac.</string>
    <!-- System audio (Core Audio process taps, macOS 14.2+) for meeting notes. Without
         this key a tap records silence and macOS never shows the prompt. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>Cado records your Mac's audio during a meeting you start, so the other participants are transcribed alongside you. Audio is processed on-device and never leaves your Mac.</string>
</dict>
</plist>
